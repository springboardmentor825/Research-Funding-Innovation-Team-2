# Local MongoDB
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=research_platform

# Generate a long random value; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional external user service; omit to use this application's MongoDB users.
USER_SERVICE_URL=

# Required only for /api/documents endpoints.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-your-supabase-key
